{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registry.561.group/@red-cup-engineering/derive-hive-account-ledger-service/schema/derive-hive-account-ledger.output.schema.json",
  "title": "deriveHiveAccountLedgerOutput",
  "type": "object",
  "required": ["type", "version", "account", "ledgerText", "accountsOpened", "transactionCount", "balanceComparison", "refusals"],
  "properties": {
    "type": { "const": "HiveAccountLedgerSet" },
    "version": { "const": 1 },
    "account": { "type": "string" },
    "rangeStart": { "type": "string" },
    "rangeEnd": { "type": "string" },
    "ledgerText": { "type": "string" },
    "accountsOpened": { "type": "array", "items": { "type": "string" } },
    "transactionCount": { "type": "integer" },
    "fillsBooked": { "type": "integer" },
    "nativeRewardTotals": {
      "type": "object",
      "properties": {
        "author": { "type": "object" }, "curation": { "type": "object" },
        "interest": { "type": "object" }, "staking": { "type": "object" }
      }
    },
    "balanceComparison": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["account", "commodity", "computedClosing", "chainClosing", "match"],
        "properties": {
          "account": { "type": "string" }, "commodity": { "type": "string" },
          "computedClosing": { "type": "string" }, "chainClosing": { "type": "string" },
          "match": { "type": "boolean" }
        }
      }
    },
    "refusals": { "type": "array", "items": { "type": "object" } }
  }
}
